<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <OutputPath>$(MSBuildThisFileDirectory)/../../1.7/Assemblies</OutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- RimWorld 1.7 (Waylith): 直接引用游戏根目录程序集（原版 API 在 1.7 未变化，
       见仓库 Docs 下 1.6->1.7 兼容性核对）。可用 /p:GameDir=... 覆盖游戏目录。 -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)../../../..</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(GameDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
